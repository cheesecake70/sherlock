# Sherlock Environment Configuration

# Optional: Anthropic API Key for Live Claude Agent mode
# Leave blank to use scripted scenarios and local evaluation mode only
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Model for live agent mode (default: claude-haiku-4-5)
SHERLOCK_MODEL=claude-haiku-4-5

# Optional: Server host and port configuration
SHERLOCK_HOST=127.0.0.1
SHERLOCK_PORT=8000
